{
  "name": "forge-and-fortune",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:unit": "jest tests/unit --coverage --coverageDirectory=coverage/unit",
    "test:integration": "jest tests/integration --coverage --coverageDirectory=coverage/integration"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "game.utils.js",
      "server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {}
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
